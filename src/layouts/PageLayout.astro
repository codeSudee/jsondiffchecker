---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  updated?: string;
  updatedLabel?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  eyebrow = 'JSON Diff Checker',
  heading,
  updated,
  updatedLabel = 'Last updated:',
  noindex = false,
} = Astro.props;

const t = useContent(getLangFromUrl(Astro.url));
const breadcrumbs = [
  { name: t.nav.brand, path: Astro.url.pathname.split('/').length > 3 ? '/' + Astro.url.pathname.split('/')[1] + '/' : '/' },
  { name: heading, path: Astro.url.pathname },
];
---

<Layout title={title} description={description} noindex={noindex} breadcrumbs={breadcrumbs}>
  <SiteHeader />
  <main id="main-content">
    <section class="border-b border-hairline bg-canvas py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <p class="mono-eyebrow mb-3">{eyebrow}</p>
        <h1 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[36px]">
          {heading}
        </h1>
        {updated && <p class="mt-3 text-[13px] text-mute">{updatedLabel} {updated}</p>}

        <div class="prose-content mt-10 text-[15px] leading-relaxed text-body">
          <slot />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .prose-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink, #171717);
  }
  .prose-content :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-content :global(p) {
    margin-top: 1rem;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-top: 1rem;
    padding-left: 1.25rem;
  }
  .prose-content :global(ul) {
    list-style-type: disc;
  }
  .prose-content :global(ol) {
    list-style-type: decimal;
  }
  .prose-content :global(li) {
    margin-top: 0.4rem;
  }
  .prose-content :global(a) {
    color: var(--color-ink, #171717);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }
  .prose-content :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .prose-content :global(strong) {
    color: var(--color-ink, #171717);
  }
</style>
