---
import ErrorLayout from '../layouts/ErrorLayout.astro';

const title = '404 — Page Not Found | JSON Diff Checker';
const description = "The page you're looking for doesn't exist or may have moved.";
---

<ErrorLayout title={title} description={description} code="404" heading="Page not found">
  <p>
    The page you're looking for doesn't exist, may have been moved, or the link might be broken.
  </p>
</ErrorLayout>
