---
---

<div class="flex min-h-0 flex-1 flex-col border-t border-hairline" data-role="diff-panel">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline bg-canvas-elevated px-4 py-2.5">
    <div class="flex items-center gap-4">
      <span class="mono-eyebrow">Diff result</span>
      <div class="flex items-center gap-3 text-[13px]" data-role="diff-stats" aria-live="polite" aria-atomic="true">
        <span class="flex items-center gap-1.5 text-diff-added">
          <span class="inline-block h-2 w-2 rounded-full bg-diff-added" aria-hidden="true"></span>
          <span data-role="stat-added">0</span> added
        </span>
        <span class="flex items-center gap-1.5 text-diff-removed">
          <span class="inline-block h-2 w-2 rounded-full bg-diff-removed" aria-hidden="true"></span>
          <span data-role="stat-removed">0</span> removed
        </span>
        <span class="flex items-center gap-1.5 text-diff-changed">
          <span class="inline-block h-2 w-2 rounded-full bg-diff-changed" aria-hidden="true"></span>
          <span data-role="stat-changed">0</span> changed
        </span>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-1.5">
      <label class="flex items-center gap-1.5 pr-1 text-[13px] text-body" title="Match array elements by value/identity instead of position">
        <input
          type="checkbox"
          class="h-3.5 w-3.5 rounded-sm border-hairline text-link focus:outline-none focus:ring-2 focus:ring-link"
          data-role="ignore-array-order"
        />
        <span class="hidden sm:inline">Ignore array order</span>
        <span class="sm:hidden">Ignore order</span>
      </label>
      <div class="mx-1 hidden h-4 w-px bg-hairline sm:block"></div>
      <button type="button" class="btn-sm" data-action="prev-diff" title="Previous difference (Shift+Enter)">
        <span aria-hidden="true">↑</span> Prev
      </button>
      <button type="button" class="btn-sm" data-action="next-diff" title="Next difference (Enter)">
        <span aria-hidden="true">↓</span> Next
      </button>
      <div class="mx-1 hidden h-4 w-px bg-hairline sm:block"></div>
      <button type="button" class="btn-sm" data-action="copy-diff" title="Copy diff as JSON Patch">
        Copy
      </button>
      <div class="relative">
        <button type="button" class="btn-sm" data-action="download-menu-toggle" title="Download diff" aria-haspopup="true" aria-expanded="false">
          Download <span aria-hidden="true">⌄</span>
        </button>
        <div
          class="absolute right-0 top-full z-10 mt-1 hidden w-44 flex-col overflow-hidden rounded-sm border border-hairline bg-canvas-elevated floating-shadow"
          data-role="download-menu"
          role="menu"
        >
          <button type="button" class="px-3 py-2 text-left text-[13px] hover:bg-hairline-soft" data-action="download-patch" role="menuitem">
            JSON Patch (.json)
          </button>
          <button type="button" class="px-3 py-2 text-left text-[13px] hover:bg-hairline-soft" data-action="download-markdown" role="menuitem">
            Markdown changelog (.md)
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="min-h-0 flex-1 overflow-auto bg-canvas-elevated" data-role="diff-output">
    <div class="flex h-full items-center justify-center p-6 text-center sm:p-10" data-role="diff-empty">
      <div class="max-w-sm">
        <p class="text-[14px] text-mute">
          Paste or load JSON into both panes above to see the diff here.
        </p>
      </div>
    </div>
    <pre class="hidden whitespace-pre px-3 py-3 font-mono text-[12px] leading-[19px] sm:px-4 sm:text-[13px] sm:leading-[20px]" data-role="diff-tree" aria-live="polite"></pre>
  </div>
</div>
