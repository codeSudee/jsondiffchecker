---
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { useContent } from '../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const tp = useTranslatedPath(lang);
const h = t.hero;
---

<section class="relative overflow-hidden border-b border-hairline bg-canvas">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-0 h-[420px] opacity-60"
    style="background: radial-gradient(600px 300px at 15% 0%, color-mix(in srgb, var(--color-gradient-develop-start) 35%, transparent), transparent 60%), radial-gradient(500px 260px at 55% -10%, color-mix(in srgb, var(--color-violet) 30%, transparent), transparent 60%), radial-gradient(500px 260px at 85% 10%, color-mix(in srgb, var(--color-gradient-ship-end) 30%, transparent), transparent 60%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-12 text-center sm:px-6 sm:pt-28 sm:pb-20">
    <p class="mono-eyebrow mb-4 inline-flex items-center gap-2 rounded-pill-category border border-hairline bg-canvas-elevated px-3 py-1 text-[11px] sm:text-xs">
      {h.badge}
    </p>
    <h1 class="mx-auto max-w-3xl text-[32px] font-semibold leading-[1.1] tracking-[-0.02em] text-ink sm:text-[56px] sm:leading-[1.02] sm:tracking-[-0.04em]">
      {h.titleLine1}<br />{h.titleLine2}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-[16px] leading-relaxed text-body sm:text-[17px]">
      {h.subtitle}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 xs:flex-row xs:flex-wrap">
      <a href={tp('/#tool')} class="inline-flex w-full items-center justify-center rounded-pill bg-ink px-5 py-2.5 text-[15px] font-medium text-on-primary hover:opacity-85 xs:w-auto">
        {h.ctaPrimary}
      </a>
      <a href={tp('/#features')} class="inline-flex w-full items-center justify-center rounded-pill border border-hairline bg-canvas-elevated px-5 py-2.5 text-[15px] font-medium text-ink hover:bg-hairline-soft xs:w-auto">
        {h.ctaSecondary}
      </a>
    </div>
    <nav class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px] text-mute" aria-label={t.nav.secondaryNavLabel}>
      <a href={tp('/about-us')} class="hover:text-ink">{h.aboutUs}</a>
      <a href={tp('/contact-us')} class="hover:text-ink">{h.contactUs}</a>
      <a href={tp('/privacy-policy')} class="hover:text-ink">{h.privacyPolicy}</a>
      <a href={tp('/terms-and-conditions')} class="hover:text-ink">{h.terms}</a>
    </nav>
  </div>
</section>
