---
import EditorPane from './EditorPane.astro';
import DiffPanel from './DiffPanel.astro';
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
---

<div
  class="flex flex-col overflow-hidden rounded-md border border-hairline bg-canvas-elevated floating-shadow"
  data-role="diff-checker"
>
  <div class="grid flex-none grid-cols-1 divide-y divide-hairline md:min-h-[320px] md:grid-cols-2 md:divide-x md:divide-y-0">
    <EditorPane side="left" label={t.editor.originalLabel} />
    <EditorPane side="right" label={t.editor.updatedLabel} />
  </div>
  <DiffPanel />
</div>

<script>
  import '../scripts/diff-checker';
</script>
