---
import DiffChecker from './DiffChecker.astro';
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';
import { lastUpdated } from '../data/changelog';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const updatedLabel = t.about_us.lastUpdatedLabel;
const updatedText = new Date(`${lastUpdated}T00:00:00Z`).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<section id="tool" class="bg-canvas py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-6 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mono-eyebrow mb-2">{t.tool.eyebrow}</p>
        <h2 class="text-[24px] font-semibold tracking-[-0.02em] text-ink sm:text-[28px]">
          {t.tool.heading}
        </h2>
      </div>
      <div class="text-[13px] text-mute sm:text-right">
        <p>{t.tool.note}</p>
        <p class="mt-1">
          {updatedLabel} <time datetime={lastUpdated}>{updatedText}</time>
          {lang === 'en' && <> · <a href="/changelog" class="underline underline-offset-2 hover:text-ink">Changelog</a></>}
        </p>
      </div>
    </div>

    <DiffChecker />
  </div>
</section>
