---
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';

const t = useContent(getLangFromUrl(Astro.url));
const g = t.errorsGuide;
---

{
  g && (
    <section id="common-errors" class="border-b border-hairline bg-canvas py-20 sm:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="text-center">
          <p class="mono-eyebrow mb-3">{g.eyebrow}</p>
          <h2 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[36px]">{g.heading}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-body">{g.intro}</p>
        </div>

        <div class="mt-12 flex flex-col gap-10">
          {g.items.map((item) => (
            <article>
              <h3 class="text-[18px] font-semibold tracking-[-0.02em] text-ink">{item.title}</h3>
              <p class="mt-2 max-w-3xl text-[14px] leading-relaxed text-body">{item.body}</p>
              <div class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-md border border-hairline sm:grid-cols-2">
                <div class="bg-canvas-elevated">
                  <p class="mono-eyebrow border-b border-hairline px-3 py-2">{g.leftLabel}</p>
                  <pre class="overflow-auto px-4 py-3 font-mono text-[12px] leading-[20px] text-body sm:text-[13px]">{item.leftJson}</pre>
                </div>
                <div class="bg-canvas-elevated">
                  <p class="mono-eyebrow border-b border-hairline px-3 py-2">{g.rightLabel}</p>
                  <pre class="overflow-auto px-4 py-3 font-mono text-[12px] leading-[20px] text-body sm:text-[13px]">{item.rightJson}</pre>
                </div>
              </div>
              <p class="mt-3 text-[14px] leading-relaxed text-body">
                <span class="font-medium text-ink">{g.resultLabel}: </span>{item.result}
              </p>
            </article>
          ))}
        </div>

        <p class="mt-12 max-w-3xl text-[14px] leading-relaxed text-body">{g.outro}</p>
      </div>
    </section>
  )
}
