---
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2 text-[15px] font-semibold text-ink">
          <span class="flex h-6 w-6 items-center justify-center rounded-sm bg-ink text-[13px] font-semibold text-on-primary">{'{}'}</span>
          JSON Diff Checker
        </div>
        <p class="mt-3 text-[13px] leading-relaxed text-mute">
          A free, private, browser-only JSON comparison tool. Nothing you paste is ever sent anywhere.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <p class="mono-eyebrow mb-3">Product</p>
          <ul class="flex flex-col gap-2 text-[13px] text-body">
            <li><a href="/#tool" class="hover:text-ink">JSON diff tool</a></li>
            <li><a href="/#features" class="hover:text-ink">Features</a></li>
            <li><a href="/#privacy" class="hover:text-ink">Privacy</a></li>
            <li><a href="/#faq" class="hover:text-ink">FAQ</a></li>
          </ul>
        </div>
        <div>
          <p class="mono-eyebrow mb-3">Resources</p>
          <ul class="flex flex-col gap-2 text-[13px] text-body">
            <li><a href="https://www.rfc-editor.org/rfc/rfc6901" class="hover:text-ink" rel="noopener noreferrer" target="_blank">JSON Pointer spec</a></li>
            <li><a href="https://www.rfc-editor.org/rfc/rfc6902" class="hover:text-ink" rel="noopener noreferrer" target="_blank">JSON Patch spec</a></li>
          </ul>
        </div>
        <div>
          <p class="mono-eyebrow mb-3">Company</p>
          <ul class="flex flex-col gap-2 text-[13px] text-body">
            <li><a href="/about-us" class="hover:text-ink">About us</a></li>
            <li><a href="/contact-us" class="hover:text-ink">Contact us</a></li>
            <li><a href="/privacy-policy" class="hover:text-ink">Privacy policy</a></li>
            <li><a href="/terms-and-conditions" class="hover:text-ink">Terms and conditions</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-hairline pt-6 text-[12px] text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} JSON Diff Checker. All processing happens locally in your browser.</p>
      <p>Not affiliated with json-diff.com.</p>
    </div>
  </div>
</footer>
