---
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { useContent } from '../i18n/content';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const tp = useTranslatedPath(lang);
const f = t.footer;
const year = new Date().getFullYear();
const copyright = f.copyright.replace('{year}', String(year));
---

<footer class="border-t border-hairline bg-canvas">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2 text-[15px] font-semibold text-ink">
          <span class="flex h-6 w-6 items-center justify-center rounded-sm bg-ink text-[13px] font-semibold text-on-primary">{'{}'}</span>
          {t.nav.brand}
        </div>
        <p class="mt-3 text-[13px] leading-relaxed text-mute">
          {f.tagline}
        </p>
        <div class="mt-4">
          <LanguagePicker variant="footer" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <p class="mono-eyebrow mb-3">{f.productHeading}</p>
          <ul class="flex flex-col gap-2 text-[13px] text-body">
            <li><a href={tp('/#tool')} class="hover:text-ink">{f.jsonDiffTool}</a></li>
            <li><a href={tp('/#features')} class="hover:text-ink">{f.features}</a></li>
            <li><a href={tp('/#privacy')} class="hover:text-ink">{f.privacy}</a></li>
            <li><a href={tp('/#faq')} class="hover:text-ink">{f.faq}</a></li>
          </ul>
        </div>
        <div>
          <p class="mono-eyebrow mb-3">{f.resourcesHeading}</p>
          <ul class="flex flex-col gap-2 text-[13px] text-body">
            <li><a href="https://www.rfc-editor.org/rfc/rfc6901" class="hover:text-ink" rel="noopener noreferrer" target="_blank">{f.jsonPointerSpec}</a></li>
            <li><a href="https://www.rfc-editor.org/rfc/rfc6902" class="hover:text-ink" rel="noopener noreferrer" target="_blank">{f.jsonPatchSpec}</a></li>
          </ul>
        </div>
        <div>
          <p class="mono-eyebrow mb-3">{f.companyHeading}</p>
          <ul class="flex flex-col gap-2 text-[13px] text-body">
            <li><a href={tp('/about-us')} class="hover:text-ink">{f.aboutUs}</a></li>
            <li><a href={tp('/contact-us')} class="hover:text-ink">{f.contactUs}</a></li>
            <li><a href={tp('/privacy-policy')} class="hover:text-ink">{f.privacyPolicy}</a></li>
            <li><a href={tp('/terms-and-conditions')} class="hover:text-ink">{f.terms}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-hairline pt-6 text-[12px] text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>{copyright}</p>
      <p>{f.notAffiliated}</p>
    </div>
  </div>
</footer>
