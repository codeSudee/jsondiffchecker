---
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const a = t.about;
---

<section id="about" class="border-b border-hairline bg-canvas py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <p class="mono-eyebrow mb-3">{a.eyebrow}</p>
    <h2 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[36px]">
      {a.heading}
    </h2>

    <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-body">
      {a.paragraphs.map((p) => <p set:html={p} />)}
    </div>
  </div>
</section>
