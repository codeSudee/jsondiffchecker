---
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const features = t.features.items;
---

<section id="features" class="border-b border-hairline bg-canvas py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mono-eyebrow mb-3">{t.features.eyebrow}</p>
      <h2 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[36px]">
        {t.features.heading}
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="card hairline-shadow p-6">
          <h3 class="text-[16px] font-semibold tracking-[-0.01em] text-ink">{f.title}</h3>
          <p class="mt-2 text-[14px] leading-relaxed text-body">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
