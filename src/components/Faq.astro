---
import { getLangFromUrl } from '../i18n/utils';
import { useContent } from '../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const faqs = t.faq.items;
---

<section id="faq" class="bg-canvas py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <p class="mono-eyebrow mb-3">{t.faq.eyebrow}</p>
      <h2 class="text-[28px] font-semibold tracking-[-0.03em] text-ink sm:text-[36px]">
        {t.faq.heading}
      </h2>
    </div>

    <div class="mt-10 divide-y divide-hairline border-y border-hairline">
      {faqs.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-ink">
            {item.q}
            <span class="shrink-0 text-mute transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
