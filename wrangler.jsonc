{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "jsondiffchecker-com",
	"workers_dev": false,
	"preview_urls": false,
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/*"]
	},
	"observability": {
		"enabled": true
	}
}